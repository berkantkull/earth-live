# Sunucu portu (npm start)
PORT=8787

# Opsiyonel: OpenSky Network OAuth2 istemci bilgileri.
# Anonim erişim günde ~400 kredi ile sınırlıdır; hesapla kullanınca uçak verisi daha sık yenilenir.
# https://opensky-network.org/my-opensky/account -> API Client
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Uçak verisi önbellek süresi (saniye). Boş bırakılırsa: kimlikli 60, anonim 300.
AIRCRAFT_TTL=
